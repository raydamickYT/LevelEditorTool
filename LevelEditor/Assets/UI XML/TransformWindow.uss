.transform-window {
    position: absolute;
    left: 8px;
    top: 50px;

    width: 280px;
    padding: 10px;

    background-color: #686868;
    border-radius: 6px;
    border-width: 1px;
    border-color: #555555;
}

.window-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 10px;
}

.window-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.layer-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.layer-label {
    margin-right: 4px;
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    color: #cfcfcf;
    -unity-text-align: middle-left;
}

.layer-field {
    width: 50px;
    height: 35px;
    min-height: 30px;
    padding: 0px;
    flex-grow: 0;
    flex-shrink: 0;
}

.layer-field .unity-base-field__input {
    height: 30px;
    min-height: 30px;
    padding: 0 4px;
    margin: 0;
}


.section {
    margin-top: 8px;
    margin-bottom: 8px;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #d0d0d0;
    margin-bottom: 4px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.axis-label {
    width: 10px;
    min-width: 10px;
    color: #cfcfcf;
    font-size: 11px;
    margin-right: 3px;
}

.axis-field {
    width: 60px;
    min-width: 56px;
    max-width: 80px;
    height: 40px;
    min-height: 22px;

    margin-right: 8px;
    padding: 0;

    flex-direction: row;

    color: #000000;
    background-color: #eeeeee00;
}

.mirror-inline-button {
    width: 34px;
    min-width: 34px;
    height: 28px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    align-self: center;
    font-size: 13px;
    -unity-text-align: middle-center;
}


#reset-transform-button {
    height: 24px;
    margin-top: 8px;
}

