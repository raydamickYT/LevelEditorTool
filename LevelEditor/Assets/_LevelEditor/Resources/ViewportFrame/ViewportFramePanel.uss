.viewport-frame-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.viewport-frame-panel {
    position: absolute;
    left: 120px;
    top: 120px;

    width: 280px;
    padding: 10px;

    background-color: #686868;
    border-radius: 6px;
    border-width: 1px;
    border-color: #555555;
}

.window-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    flex-grow: 1;
}

.window-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.viewport-drag-header {
    cursor: move;
}

.viewport-close-button {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.viewport-enabled-toggle {
    margin-bottom: 8px;
    color: #e8e8e8;
}

.section {
    margin-top: 8px;
    margin-bottom: 8px;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #d0d0d0;
    margin-bottom: 4px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.axis-label {
    width: 14px;
    min-width: 14px;
    color: #cfcfcf;
    font-size: 11px;
    margin-right: 3px;
}

.axis-field {
    width: 88px;
    min-width: 72px;
    max-width: 100px;
    height: 40px;
    min-height: 22px;
    margin-right: 8px;
    padding: 0;
    color: #000000;
    background-color: #eeeeee00;
}

.viewport-lock-toggle {
    margin-top: 4px;
    color: #e0e0e0;
}

.viewport-color-row {
    align-items: center;
}

.viewport-color-preview {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-right: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;
    background-color: #ff0000;
}

.viewport-color-hex-field {
    flex-grow: 1;
    min-width: 0;
    height: 28px;
    color: #111111;
}

.viewport-hint {
    margin-top: 6px;
    font-size: 10px;
    color: #bdbdbd;
    white-space: normal;
}
