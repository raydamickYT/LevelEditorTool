.notification-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.status-toast {
    position: absolute;
    top: 46px;
    right: 16px;
}

.status-toast-label {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(35, 170, 95);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    -unity-font-style: bold;
    font-size: 13px;
    border-width: 1px;
    border-color: rgb(20, 120, 65);
}
.save-project-path-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}
.save-project-path-row .save-project-path {
    flex-grow: 1;
    margin-bottom: 0;
    margin-right: 8px;
}

.popup-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.35);
}

.popup-window {
    width: 520px;
    max-height: 420px;
    background-color: rgb(232, 232, 232);
    border-width: 1px;
    border-color: rgb(95, 95, 95);
    border-radius: 4px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.popup-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.popup-icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    border-radius: 14px;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    font-size: 18px;
}

.popup-icon-info {
    background-color: rgb(70, 120, 190);
}

.popup-icon-warning {
    background-color: rgb(205, 140, 35);
}

.popup-icon-error {
    background-color: rgb(185, 55, 45);
}

.popup-title {
    flex-grow: 1;
    color: rgb(35, 35, 35);
    -unity-font-style: bold;
    font-size: 16px;
}

.popup-message {
    color: rgb(40, 40, 40);
    white-space: normal;
    margin-bottom: 10px;
}

.popup-details-scroll {
    max-height: 170px;
    margin-top: 6px;
    margin-bottom: 12px;
    background-color: rgb(210, 210, 210);
    border-width: 1px;
    border-color: rgb(165, 165, 165);
}

.popup-details {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    color: rgb(55, 55, 55);
    white-space: normal;
    font-size: 11px;
}

.popup-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.popup-button {
    min-width: 90px;
    height: 28px;
}

.popup-primary-button {
    background-color: rgb(215, 215, 215);
    border-color: rgb(120, 120, 120);
}

.popup-primary-button:hover {
    background-color: rgb(235, 235, 235);
}

.save-project-window {
    width: 480px;
}

.save-project-title {
    margin-bottom: 10px;
}

.save-project-label {
    color: rgb(55, 55, 55);
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 4px;
}

.save-project-path {
    color: rgb(40, 40, 40);
    white-space: normal;
    margin-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
}

.save-project-name-field {
    margin-bottom: 12px;
}

.save-project-actions {
    margin-top: 4px;
}
