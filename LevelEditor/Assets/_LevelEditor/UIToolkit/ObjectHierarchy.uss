/* Same anchoring model as ObjectLibrary.uss — position set at runtime in ObjectHierarchyManager. */
.object-hierarchy {
    position: absolute;
    left: 0;
    top: 480px;
    bottom: 0;
    width: 290px;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(214, 214, 214, 0.88);
    border-right-width: 1px;
    border-right-color: rgb(140, 140, 140);
}

.object-hierarchy-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 8px;
    padding-right: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(140, 140, 140, 0.55);
    background-color: rgba(205, 205, 205, 0.95);
}

.object-hierarchy-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(45, 45, 45);
}

.object-hierarchy-collapse-button {
    height: 22px;
    min-width: 48px;
    max-width: 56px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-font-style: bold;
    font-size: 14px;
    flex-grow: 0;
    flex-shrink: 0;
}

.object-hierarchy-group-button {
    height: 24px;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 13px;
}

.object-hierarchy-scroll {
    flex-grow: 1;
    min-height: 0;
}

.object-hierarchy-collapsed .object-hierarchy-group-button {
    display: none;
}

.object-hierarchy-collapsed .object-hierarchy-scroll {
    display: none;
}

.object-hierarchy-collapsed .object-hierarchy-resize-handle {
    display: none;
}

.object-hierarchy-content {
    flex-direction: column;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 8px;
}

.hierarchy-row {
    height: 20px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.55);
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.45);
    margin-bottom: 2px;
    margin-left: 0;
}

.hierarchy-row:hover {
    background-color: rgba(117, 117, 117, 0.55);
}

.hierarchy-row-selected {
    background-color: rgba(64, 115, 255, 0.45);
}

.hierarchy-row-selected:hover {
    background-color: rgba(108, 147, 255, 0.45);
}

.hierarchy-row-dragging {
    opacity: 0.35;
    background-color: rgba(90, 130, 210, 0.55);
}

.hierarchy-row-drag-preview {
    opacity: 0.95;
    background-color: rgba(240, 246, 255, 0.98);
    border-color: rgba(64, 115, 255, 0.9);
    border-width: 1px;
}

.hierarchy-drop-indicator {
    height: 3px;
    background-color: rgb(42, 122, 255);
}

.hierarchy-indent {
    width: 4px;
    flex-shrink: 0;
}

.hierarchy-foldout-icon {
    width: 14px;
    -unity-text-align: middle-center;
    color: rgb(60, 60, 60);
}

.hierarchy-name {
    flex-grow: 1;
    overflow: hidden;
    -unity-text-align: middle-left;
    color: rgb(70, 70, 70);
    font-size: 12px;
}

.object-hierarchy-resize-handle {
    position: absolute;
    right: -4px;
    top: 0;
    bottom: 0;
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
}

.object-hierarchy-resize-handle:hover {
    background-color: rgba(80, 120, 180, 0.45);
}

.object-hierarchy-resize-handle-vertical {
    position: absolute;
    left: 0;
    right: 0;
    top: -4px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0);
}
.object-hierarchy-resize-handle-vertical:hover { background-color: rgba(80, 120, 180, 0.45); }
.object-hierarchy-collapsed .object-hierarchy-resize-handle-vertical { display: none; }