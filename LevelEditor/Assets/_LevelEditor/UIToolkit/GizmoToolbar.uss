.gizmo-toolbar {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.gizmo-tool-button {
    min-width: 64px;
    height: 28px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgb(140, 140, 140);
    border-radius: 2px;
    background-color: rgb(230, 230, 230);
    -unity-font-style: bold;
    font-size: 18px;
}

.gizmo-tool-button:hover {
    background-color: rgb(242, 242, 242);
}

.gizmo-tool-button-active {
    background-color: rgb(64, 115, 255);
    border-color: rgb(40, 80, 180);
    color: rgb(255, 255, 255);
}

.gizmo-tool-button-active:hover {
    background-color: rgb(80, 130, 255);
}

.top-bar-shortcut-tooltip {
    position: absolute;
    display: none;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(40, 40, 40, 0.95);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 3px;
    color: rgb(245, 245, 245);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
