.object-library {
    position: absolute;
    top: 300px;
    right: 0;
    bottom: 0;
    width: 380px;
    background-color: rgba(214, 214, 214, 0.9);
    border-left-width: 1px;
    border-left-color: rgb(140, 140, 140);
    border-right-width: 1px;
    border-right-color: rgb(140, 140, 140);
}

.object-library-resize-handle {
    position: absolute;
    left: -4px;
    top: 0;
    bottom: 0;
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
}

.object-library-resize-handle:hover {
    background-color: rgba(80, 120, 180, 0.45);
}

.asset-scroll-view {
    flex-grow: 1;
}

.asset-grid {
    flex-direction: column;
    padding-left: 12px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
}

.asset-folder {
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(150, 150, 150, 0.45);
    background-color: rgba(225, 225, 225, 0.45);
}

.asset-folder .unity-foldout__toggle {
    min-height: 24px;
    padding-left: 4px;
    color: rgb(45, 45, 45);
}

.asset-folder-content {
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 8px;
}

.asset-subfolder {
    width: 100%;
    margin-left: 10px;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    background-color: rgba(210, 210, 210, 0.35);
}

.asset-subfolder .unity-foldout__toggle {
    min-height: 22px;
    padding-left: 4px;
    color: rgb(60, 60, 60);
}

.asset-folder-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 8px;
    padding-top: 6px;
    padding-right: 0;
    padding-bottom: 0;
}

.asset-tile {
    width: 110px;
    height: 130px;
    margin-right: 8px;
    margin-bottom: 8px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-color: rgba(160, 160, 160, 0.35);
    border-radius: 2px;
}

.asset-tile:hover {
    background-color: rgba(255, 255, 255, 0.28);
    border-color: rgba(110, 130, 170, 0.8);
}

.asset-tile-disabled {
    opacity: 0.85;
}

.asset-thumbnail {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.asset-prefab-placeholder {
    width: 80px;
    height: 80px;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(80, 80, 80);
    background-color: rgba(190, 190, 190, 0.5);
    border-width: 1px;
    border-color: rgba(120, 120, 120, 0.5);
    border-radius: 2px;
}

.asset-label {
    margin-top: 6px;
    height: 32px;
    max-width: 96px;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: rgb(55, 55, 55);
    overflow: hidden;
}

.asset-drag-preview {
    position: absolute;
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.9;
    /* z-index: 999999; */
}
